  "name": "STM32L051K8 (8K RAM. 64K Flash)",
  "upload": {
    "maximum_ram_size": 8192,
    "maximum_size": 65536,
    "protocol": "stlink",
    "protocols": [
      "blackmagic",
      "dfu",
      "jlink",
