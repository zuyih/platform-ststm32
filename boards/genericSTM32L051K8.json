{
  "build": {
    "core": "stm32",
    "cpu": "cortex-m0plus",
    "extra_flags": "-DSTM32L0 -DSTM32L0xx -DSTM32L051xx",
    "f_cpu": "32000000L",
    "mcu": "stm32l051k8u6",
    "product_line": "STM32L051xx",
    "variant": "STM32L0xx/L051K(6-8)U"
  },
  "debug": {
    "jlink_device": "STM32L051K8",
