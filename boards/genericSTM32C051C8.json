{
  "build": {
    "core": "stm32",
    "cpu": "cortex-m0plus",
    "extra_flags": "-DSTM32C0 -DSTM32C0xx -DSTM32C051xx",
    "f_cpu": "48000000L",
    "mcu": "stm32c051c8t6",
    "product_line": "STM32C051xx",
    "variant": "STM32C0xx/C051C(6-8)(T-U)"
  },
  "debug": {
    "jlink_device": "STM32C051C8",
    "openocd_target": "stm32c0x",
    "svd_path": "STM32C051.svd"
  },
  "frameworks": [
    "arduino",
    "cmsis",
    "stm32cube",
    "libopencm3"
  ],
  "name": "STM32C051C8 (12K RAM. 64K Flash)",
  "upload": {
    "maximum_ram_size": 12288,
    "maximum_size": 65536,
    "protocol": "stlink",
    "protocols": [
      "blackmagic",
      "dfu",
      "jlink",
      "cmsis-dap",
      "serial",
      "stlink"
    ]
  },
  "url": "https://www.st.com/en/microcontrollers-microprocessors/stm32c051c8.html",
  "vendor": "Generic"
}
