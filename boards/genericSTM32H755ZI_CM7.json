{
  "build": {
    "cpu": "cortex-m7",
    "extra_flags": "-DSTM32H7 -DSTM32H7xx -DSTM32H755xx -DCORE_CM7",
    "framework_extra_flags": {
      "arduino": "-DARDUINO_GENERIC_H755ZITX"
    },
    "f_cpu": "480000000L",
    "mcu": "stm32h755zit6",
    "product_line": "STM32H755xx",
    "variant": "STM32H7xx/H745Z(G-I)T_H755ZIT"
  },
  "connectivity": [
    "can",
    "ethernet"
  ],
  "debug": {
    "default_tools": [
      "stlink"
    ],
    "jlink_device": "STM32H755ZI",
    "onboard_tools": [
      "stlink"
    ],
    "openocd_target": "stm32h7x",
    "svd_path": "STM32H755_CM7.svd"
  },
  "frameworks": [
    "arduino",
    "cmsis",
    "stm32cube",
    "libopencm3",
    "mbed",
    "zephyr"
  ],
  "name": "STM32H755ZI CM7 (512K RAM. 1024K Flash)",
  "upload": {
    "maximum_ram_size": 524288,
    "maximum_size": 1048576,
    "protocol": "stlink",
    "protocols": [
      "jlink",
      "cmsis-dap",
      "stlink",
      "blackmagic",
      "mbed"
    ]
  },
  "url": "https://www.st.com/en/microcontrollers-microprocessors/stm32h755zi.html",
  "vendor": "Generic"
}
