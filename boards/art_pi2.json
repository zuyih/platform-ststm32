{
  "build": {
    "core": "stm32",
    "cpu": "cortex-m7",
    "extra_flags": "-DSTM32H7RS -DSTM32H7RSxx -DSTM32H7R7xx",
    "f_cpu": "600000000L",
    "ldscript": "STM32H7R7L8HX_ROMXSPI2.ld",
    "mcu": "stm32h7r7l8h",
    "product_line": "STM32H7R7xx",
    "stm32cube": {
      "family": "stm32h7rs"
    }
  },
  "debug": {
    "default_tools": [
      "stlink"
    ],
    "jlink_device": "STM32H7R7L8",
    "onboard_tools": [
      "stlink"
    ],
    "openocd_target": "stm32h7rsx"
  },
  "frameworks": [
    "stm32cube"
  ],
  "name": "RealThread ART-Pi2 (8M XSPI Flash. 456k RAM)",
  "upload": {
    "maximum_ram_size": 466944,
    "maximum_size": 8388608,
    "protocol": "stlink",
    "protocols": [
      "stlink",
      "jlink",
      "cmsis-dap"
    ]
  },
  "url": "https://github.com/RT-Thread-Studio/sdk-bsp-stm32h7r-realthread-artpi2",
  "vendor": "RealThread"
}
