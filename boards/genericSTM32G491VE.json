    "extra_flags": "-DSTM32G4 -DSTM32G4xx -DSTM32G491xx",
    "f_cpu": "170000000L",
    "mcu": "stm32g491vet6",
    "product_line": "STM32G491xx",
    "variant": "STM32G4xx/G491V(C-E)T_G4A1VET"
  },
  "connectivity": [
    "can"
  ],
  "debug": {
